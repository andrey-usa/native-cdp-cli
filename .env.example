# Optional: point RustWright at a specific Chromium/Chrome/Edge executable.
# If unset, RustWright discovers a Chromium automatically, else common
# Windows/macOS/Linux install paths are probed.
RUSTWRIGHT_CHROMIUM=

# --- Lightpanda engine (`--engine lightpanda`) -----------------------------
# RustWright can only launch a process (no attach API), so lightpanda-shim
# translates its Chromium-style argv into `lightpanda serve`. Build once with
# `cargo build --bin lightpanda-shim`.
# Path of the lightpanda binary (directly, or inside the WSL distro below).
LIGHTPANDA_BIN=/home/user/lightpanda
# Windows only: run that binary through `wsl.exe -d <distro>` (no native build).
LIGHTPANDA_WSL_DISTRO=podman-machine-default
# CDP bind host (default 127.0.0.1).
LIGHTPANDA_HOST=127.0.0.1
# Optional override for the shim path (otherwise the sibling binary is used).
LIGHTPANDA_SHIM=

# Opt out of RustWright telemetry (also set by the app itself).
DISABLE_TELEMETRY=1